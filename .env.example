# Local browser dev server (or the Vercel URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Configure these on Render for the API service. Keep provider keys out of source control.
AI_MODEL_ORDER=gemini:gemini-2.5-flash-lite,gemini:gemini-2.5-flash,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash-lite,gemini:gemini-3.6-flash,gemini:gemini-3.8-flash,antigravity:antigravity-preview-09-2026,groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,zai:glm-4.7-flash,zai:glm-4.5-flash,openrouter:google/gemma-4-26b-a4b-it:free,openrouter:google/gemma-4-31b-it:free,openrouter:openrouter/free,mistral:mistral-small-latest,mistral:ministral-8b-latest,mistral:mistral-medium-latest
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: set this on Render to use your laptop through a Cloudflare Tunnel.
# For a backend running on the same PC, use http://127.0.0.1:11434/v1 instead.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b
OLLAMA_MAX_CONCURRENT_REQUESTS=1
# Required for the authenticated Quick Tunnel proxy; keep the key only on the backend.
OLLAMA_API_KEY=
OLLAMA_ACCESS_CLIENT_ID=
OLLAMA_ACCESS_CLIENT_SECRET=
ZAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Optional additional server-side generation providers.
# Cloudflare requires BOTH the token and its 32-character Account ID.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Vercel also accepts AI_GATEWAY_API_KEY as a fallback alias.
VERCEL_AI_GATEWAY_API_KEY=
# Also enables Typhoon OCR; TYPHOON_OCR_API_KEY is a fallback alias.
TYPHOON_API_KEY=
# AI_MODEL_ORDER is an allowlist and preference order. A configured
# OLLAMA_BASE_URL automatically prepends its OLLAMA_MODEL to this list.
# Optional public article reader fallback. Server-only; never NEXT_PUBLIC_.
SMRY_API_KEY=
FRONTEND_ORIGINS=http://localhost:3000

# Optional: create a Tavily key to turn on web search enrichment.
TAVILY_API_KEY=

# Configure on Render for Google sign-in and Google Sheets account storage.
GOOGLE_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
SESSION_SECRET=

# Configure on Vercel. This is public and is safe to expose in the frontend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
