# Local browser dev server (or the Vercel URL in production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Configure these on Render for the API service. Keep provider keys out of source control.
AI_MODEL_ORDER=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,gemini:gemini-3.8-flash,gemini:gemini-3.7-flash,gemini:gemini-3.6-flash,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,openrouter:qwen/qwen3.8-27b:free,openrouter:google/gemma-4-26b-a4b-it:free,openrouter:google/gemma-4-31b-it:free,openrouter:openrouter/free,mistral:mistral-small-latest,mistral:ministral-8b-latest,mistral:mistral-medium-latest
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
FRONTEND_ORIGINS=http://localhost:3000

# Optional: create a Tavily key to turn on web search enrichment.
TAVILY_API_KEY=

# Configure on Render for Google sign-in and Google Sheets account storage.
GOOGLE_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
SESSION_SECRET=

# Configure on Vercel. This is public and is safe to expose in the frontend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
